# Copy to .env (git-ignored). Application access uses the scoped dow_user.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=dow
DOW_CLICKHOUSE_USER=dow_user
DOW_CLICKHOUSE_PASSWORD=dow_secret

# Admin account: used ONLY by scripts/init_clickhouse.py and scripts/migrate_p2_review.py
# (CREATE USER / GRANT / EXCHANGE TABLES). Never used by the dowtheory package.
CLICKHOUSE_USER=trading_user
CLICKHOUSE_PASSWORD=trading_secret
